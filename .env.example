# ---- App orchestrator ----
APP_PORT=8000
APP_SECRET_KEY=change-me

# ---- LLM backend for classify/extract ----
# "ollama" keeps email content on-prem (see docs/llm-backend.md) — use
# this for any client with EU data-residency requirements. "claude" is
# there for fast POCs where that constraint doesn't apply.
LLM_PROVIDER=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=mistral:7b-instruct
# How long Ollama keeps the model in memory after the last request (a cold
# load takes minutes on CPU, so don't let it unload mid-demo).
OLLAMA_KEEP_ALIVE=24h
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- App / audit database ----
APP_DB_USER=appuser
APP_DB_PASSWORD=apppassword
APP_DB_NAME=email_ops
APP_DB_PORT=5432

# ---- Email simulator ----
EMAIL_SIM_PORT=8001

# ---- EspoCRM ----
ESPOCRM_PORT=8080
ESPOCRM_DB_ROOT_PASSWORD=root_password
ESPOCRM_DB_NAME=espocrm
ESPOCRM_DB_USER=espocrm
ESPOCRM_DB_PASSWORD=espocrm_password
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=change-me
ESPOCRM_SITE_URL=http://localhost:8080
# Generate after first login: Administration > API Users, or a personal API key
ESPOCRM_API_KEY=

# ---- Plane (self-hosted separately, or Plane Cloud) — see docs/plane-setup.md ----
PLANE_API_BASE_URL=https://api.plane.so
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=
# Project new support-request issues get filed into (from the project's
# settings/URL in the Plane UI).
PLANE_DEFAULT_PROJECT_ID=

# ---- Adminer (DB browser) ----
ADMINER_PORT=8082
